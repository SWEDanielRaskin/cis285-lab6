@startuml payment-settlement-sequence
' Status: Draft - Reconciliation Incomplete. AI-reconciled; not human reviewed (Principle VII).
' Written source: contracts/service-contracts.md, DEC-26, DEC-27
title Payment Settlement\nFR-030 to FR-033, FR-027 (conditional draft: OC-1 open)

actor "Payer\n(signed-in user)" as Payer
participant "PaymentFormPanel\nOverpaymentConfirmDialog" as Panel
participant "PaymentController\n(via UiTaskRunner)" as Ctrl
participant "PaymentService" as Svc
participant "AccessPolicy" as Access
participant "TransactionRunner" as Tx
participant "LedgerReader" as Reader
database "LedgerQueryRepository" as Ledger
participant "BalanceCalculator" as Calc
participant "Payment" as Pay
database "PaymentRepository" as Repo

Payer -> Panel : group, recipient, amount, date, optional note
Panel -> Ctrl : submit raw values
Ctrl -> Svc : recordPayment(session, draft without acknowledgedOwed)
Svc -> Access : requireSession(session)
Svc -> Svc : PREPARE: parse amount, date, note; collect FieldErrors
Svc -> Tx : inTransaction
activate Tx
Tx -> Access : requireActiveMember(session, group)
alt payer not an active member
  Tx --> Ctrl : NotFoundException, rollback
else payer is a member
  Tx -> Tx : VALIDATE: recipient active and not self\n(MembershipRepository.areActiveMembers)
  alt any FieldError (FR-030)
    Tx --> Ctrl : ValidationException, rollback
    Ctrl --> Panel : field errors; input kept
  else valid
    Tx -> Reader : owedBy(payer, recipient, group)
    Reader -> Ledger : entriesForPair(group, payer, recipient)
    note right of Ledger : Approved shares and payments only.\nOnly the named group (FR-027).
    Reader -> Calc : calculate(entries)
    Calc --> Reader : BalanceSheet
    Reader --> Tx : owedNow (0 or more)
    alt amount above owedNow, and acknowledgedOwed absent or different (FR-032)
      Tx --> Svc : nothing written, rollback
      Svc --> Ctrl : OverpaymentWarning(owedNow, attempted)
      Ctrl --> Panel : dialog shows both amounts; Cancel is the default
      alt payer cancels
        Panel --> Payer : form kept; no payment recorded
      else payer confirms
        Panel -> Ctrl : confirm
        Ctrl -> Svc : recordPayment(session, draft with acknowledgedOwed = owedNow)
        note right of Svc : Runs this flow again.\nA changed amount owed gives a fresh warning (DEC-27).
      end
    else within owedNow, or acknowledged amount matches
      Tx -> Pay : create(...), overpaymentConfirmed set if the guard fired
      Tx -> Repo : insert(payment)
      note right of Repo
        FR-031: applies at commit; no recipient confirmation.
        Balance is derived, so no balance row changes.
        Other group balances do not change.
        Insert-only (NFR-006). Creates no notification (DEC-17).
      end note
      Tx --> Svc : commit
      Svc --> Ctrl : Recorded(paymentView)
      Ctrl --> Panel : confirmation; refresh balances
    end
  end
end
deactivate Tx

== History (FR-033) ==
Payer -> Ctrl : open history
Ctrl -> Svc : paymentHistory(session, group)
Svc -> Tx : readOnly
Tx -> Repo : listForUser(user, group)
note right of Repo : Same records for payer and recipient,\nincluding after leaving the group (BR-16).
Svc --> Ctrl : payment views

note over Svc, Repo
  Worked example, Story 6 scenario 2: sam owes alex 30.00 and pays 40.00.
  Warning, then confirmed. Entries: sam owes alex 30.00; alex owes sam 40.00.
  Net: alex owes sam 10.00.
end note

@enduml
